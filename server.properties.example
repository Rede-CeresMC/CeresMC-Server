motd=CeresMC Server
server-port=19132
max-players=20
gamemode=creative
difficulty=peaceful
level-name=world
view-distance=10
white-list=off
pvp=on
keep-inventory=off
# players must accept the packs in resource_packs/ to join
force-resource-packs=on
# mobs appearing by themselves near players
spawn-animals=on
spawn-monsters=on
# creeper and ghast explosions break blocks, endermen pick blocks up
mob-griefing=on
xbox-auth=on
# NetherNet: UDP ports for players' connections (forward them on the router for players from outside)
nethernet-udp-ports=19300-19399
# NetherNet: public IP to offer (empty = the address the player typed)
nethernet-public-ip=
